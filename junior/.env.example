# Supabase (Project settings > API). Locally, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public URL of this app, used in sign-in emails and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude drafts the posts. https://console.anthropic.com
# Either name works. Use JUNIOR_ANTHROPIC_API_KEY on a machine where another
# tool already uses ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# JUNIOR_ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Voice notes are transcribed with OpenAI's speech-to-text API before drafting.
# Leave empty to switch audio uploads off.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Local development only: without an Anthropic key, Junior can return
# placeholder drafts so you can click through the flow. Never set in production.
# JUNIOR_DEMO_DRAFTS=1

# --- Phase 2: connections and scheduled publishing -------------------------

# Server-only Supabase key (Project settings > API > secret key). Used by the
# publisher and to store encrypted tokens. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts social tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it disconnects every account.
TOKEN_ENCRYPTION_KEY=

# Shared secret for /api/cron/publish. Supabase (pg_cron) or Vercel Cron sends
# it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Meta app (developers.facebook.com) with Facebook Login for Business.
# Permissions: pages_show_list, pages_read_engagement, pages_manage_posts,
# instagram_basic, instagram_content_publish, business_management.
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business apps: the configuration ID from
# Facebook Login for Business > Configurations. Leave empty for classic login.
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v26.0

# LinkedIn app (linkedin.com/developers) with "Sign In with LinkedIn using
# OpenID Connect" and "Share on LinkedIn".
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202608

# --- Phase 3: newsletter --------------------------------------------------

# Resend (resend.com). Verify NEWSLETTER_FROM_DOMAIN in Resend first; issues
# go out as "<sender name> <newsletter@NEWSLETTER_FROM_DOMAIN>" with replies
# to the lawyer.
RESEND_API_KEY=
NEWSLETTER_FROM_DOMAIN=
# Webhook signing secret (Resend > Webhooks), for deliveries, opens, clicks,
# bounces and complaints. Endpoint: <NEXT_PUBLIC_SITE_URL>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
